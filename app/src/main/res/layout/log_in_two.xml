<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LogInTwo">


    <ImageView
        android:id="@+id/name_output"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="100dp"
        android:src="@drawable/nandi_icoooon"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_marginTop="60dp"
        android:id="@+id/vivivi"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_below="@id/name_output"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        app:passwordToggleEnabled="true"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/input_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Entry password"
            android:maxLength="10"
            android:text=""
            android:ems="6"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            android:textColor="#E401284A"
            android:textSize="17sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/go"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_below="@id/vivivi"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp"
        android:background="@drawable/button_shape"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:fontFamily="@font/aclonica"
        android:text="Go"
        android:textSize="17sp"
        android:textColor="#FFFFFF"
        tools:ignore="NotSibling" />

</RelativeLayout>