<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <ImageView
            android:id="@+id/bitmoji"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            android:src="@drawable/bitmoji_person" />


        <TextView
            android:id="@+id/cust_code77"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:text="hello"
            android:textColor="#091e26"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cust_name77"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="5dp"
            android:textStyle="bold"
            android:text="hello"
            android:textColor="#091e26"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/cust_region77"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="5dp"
            android:textStyle="bold"
            android:text="hello"
            android:textColor="#091e26"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/cust_sls_psn77"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="5dp"
            android:textStyle="bold"
            android:text="hello"
            android:textColor="#091e26"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/cust_type77"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="5dp"
            android:textStyle="bold"
            android:text="hello"
            android:textColor="#091e26"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/cust_lst_no77"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="5dp"
            android:textStyle="bold"
            android:text="hello"
            android:textColor="#091e26"
            android:textSize="15sp" />

<!--
        <Button
            android:id="@+id/btn_delete_firebase"
